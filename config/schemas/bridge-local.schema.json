{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KingPepe Native-Solana Bridge Local Environment Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "nativeNetwork",
    "solanaCluster"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "const": "localnet"
    },
    "nativeNetwork": {
      "type": "string",
      "const": "kingpepe-regtest"
    },
    "solanaCluster": {
      "type": "string",
      "const": "localnet"
    },
    "attestation": {
      "type": "object",
      "properties": {
        "attesterAKeyRef": {
          "type": "string"
        },
        "attesterBKeyRef": {
          "type": "string"
        }
      },
      "required": [
        "attesterAKeyRef",
        "attesterBKeyRef"
      ],
      "additionalProperties": false
    },
    "program": {
      "type": "object",
      "properties": {
        "bridgeProgramId": {
          "type": "string"
        },
        "transceiverProgramId": {
          "type": "string"
        },
        "mint": {
          "type": "string"
        },
        "tokenProgram": {
          "type": "string"
        }
      },
      "required": [
        "bridgeProgramId",
        "transceiverProgramId",
        "mint",
        "tokenProgram"
      ],
      "additionalProperties": false
    },
    "architecture": {
      "const": "ONE_WAY_AUTOMATIC_BURN_AND_MINT"
    },
    "burn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custodyModel",
        "keyReference",
        "nativeDepositConfirmations",
        "nativeBurnConfirmations",
        "feeFunding",
        "bridgeFeeAtomic"
      ],
      "properties": {
        "custodyModel": {
          "const": "SINGLE_KEY_ACCEPTED_RISK"
        },
        "keyReference": {
          "const": "PROTECTED_SERVER_SIDE_ONLY"
        },
        "nativeDepositConfirmations": {
          "const": 12
        },
        "nativeBurnConfirmations": {
          "const": 12
        },
        "feeFunding": {
          "const": "SEPARATE_OPERATIONAL_INPUTS"
        },
        "bridgeFeeAtomic": {
          "const": "0"
        }
      }
    }
  },
  "description": "Non-secret localnet example only; not a complete service deployment configuration."
}
