{
  "name": "@kingpepe/native-solana-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Proprietary KingPepe Native to Solana bridge source and tests.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "bridge": "cli/bridge.mjs"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "bridge": "node cli/bridge.mjs",
    "burn:service": "node services/bridge-validator/burn-service.mjs",
    "burn:mainnet-service": "node services/bridge-validator/burn-mainnet-service.mjs",
    "local:proof:burn": "node scripts/regtest-burn-proof.mjs",
    "local:e2e:native-to-solana": "node solana/tests/burn-chain-regression.mjs",
    "local:e2e:windows-runtime": "node solana/tests/burn-runtime-regression.mjs",
    "test": "npm run test:protocol && npm run test:burn && npm run test:native-node && npm run test:solana-observer && npm run test:bridge-validator && npm run test:source-policy",
    "test:burn": "node --test native/burn/tests/*.test.mjs",
    "test:protocol": "node solana/ts/scripts/verify-vectors.mjs",
    "test:native-node": "node --test native/node/tests/*.test.mjs",
    "test:solana-observer": "node --test services/solana-observer/tests/*.test.mjs",
    "test:bridge-validator": "node --test services/bridge-validator/tests/*.test.mjs",
    "test:source-policy": "node --test scripts/tests/*.test.mjs",
    "test:windows-security": "node --test --test-concurrency=1 tests/windows/*.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.3.0",
    "@scure/base": "2.4.0",
    "borsh": "2.0.0"
  }
}
